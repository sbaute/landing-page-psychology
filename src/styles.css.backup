@import "tailwindcss";

@plugin "daisyui" {
  themes: cupcake;
}

html {
  scroll-behavior: smooth;
}

section {
  scroll-margin-top: 90px;
}

@keyframes gradientMoveStrong {
  0% {
    background-position: 0% 0%;
  }
  50% {
    background-position: 100% 100%;
  }
  100% {
    background-position: 0% 0%;
  }
}

.animate-gradient-strong {
  animation: gradientMoveStrong 10s ease-in-out infinite;
}

@layer base {
  .font-dancing {
    font-family: 'Dancing Script', cursive;
  }

  .font-inter {
    font-family: 'Inter', system-ui, sans-serif;
  }

  .font-sora {
    font-family: 'Sora', system-ui, sans-serif;
  }
}

/* estilos para las section and container */
@layer components {
    .section {
    @apply
      w-full
     /* desktop */
  }























































































































































































































































































































































